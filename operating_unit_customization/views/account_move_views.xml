<odoo>
    <data>
        <record model="ir.ui.view" id="operating_unit_account_move_form_view">
            <field name="name">operating.unit.account.move.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="operating_unit_id" attrs="{'invisible': [('move_type','not in',('out_invoice','out_refund'))]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

