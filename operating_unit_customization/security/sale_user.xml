<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="sale_user" model="ir.rule">
            <field name="name">User will only see sales whose operating unit is the same as theirs</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="domain_force">['|', ('operating_unit_id', 'in', user.operating_unit_ids.ids), ('operating_unit_id', '=', False)]</field>
        </record>

        <record id="sale_order_user_report" model="ir.rule">
            <field name="name">User will only see sale order values whose operating unit is the same as theirs in the sales analysis</field>
            <field name="model_id" ref="sale.model_sale_report"/>
            <field name="domain_force">['|', ('operating_unit_id', 'in', user.operating_unit_ids.ids), ('operating_unit_id', '=', False)]</field>
        </record>

    </data>
</odoo>